}

MODELMACRO
{
ADD world %RBNAME%Pos dummy
MOV %RBNAME% %RBNAME%Pos

ADD %RBNAME%_rm %RBNAME%_LK0_DUMMY dummy
AXIS6 %RBNAME%_LK0_DUMMY=0,0,-450,90,0,90
HID %RBNAME%_LK0_DUMMY
ADD %RBNAME%_LK0_DUMMY %RBNAME%_LK0 "%RBPATH%\HP6_LK0.hsf"
AXIS6 %RBNAME%_LK0=0,0,0,0,0,0

ADD %RBNAME%_link1 %RBNAME%_LK1_DUMMY dummy
AXIS6 %RBNAME%_LK1_DUMMY=0,0,0,90,0,90
HID %RBNAME%_LK1_DUMMY
ADD %RBNAME%_LK1_DUMMY %RBNAME%_LK1 "%RBPATH%\HP6_LK1.hsf"
AXIS6 %RBNAME%_LK1=0,0,0,0,0,0

ADD %RBNAME%_link2 %RBNAME%_LK2_DUMMY dummy
AXIS6 %RBNAME%_LK2_DUMMY=0,0,0,90,90,00
HID %RBNAME%_LK2_DUMMY
ADD %RBNAME%_LK2_DUMMY %RBNAME%_LK2 "%RBPATH%\HP6_LK2.hsf"
