HID %RBNAME%_LK3_DUMMY
ADD %RBNAME%_LK3_DUMMY %RBNAME%_LK3 "%RBPATH%\HP6_LK3.hsf"
AXIS6 %RBNAME%_LK3=0,0,0,0,0,0

ADD %RBNAME%_link4 %RBNAME%_LK4_DUMMY dummy
AXIS6 %RBNAME%_LK4_DUMMY=0,0,0,0,0,-90
HID %RBNAME%_LK4_DUMMY
ADD %RBNAME%_LK4_DUMMY %RBNAME%_LK4 "%RBPATH%\HP6_LK4.hsf"
AXIS6 %RBNAME%_LK4=0,0,0,0,0,0

ADD %RBNAME%_LK4 %RBNAME%_LK4_LABEL dummy
AXIS6 %RBNAME%_LK4_LABEL=0,0,0,0,0,90
HID %RBNAME%_LK4_LABEL
ADD %RBNAME%_LK4_LABEL %RBNAME%_MOTOMAN1 "%RBPATH%\MOTOMAN.mdl"
AXIS6 %RBNAME%_MOTOMAN1=10,65,-200,180,-90,0
ADD %RBNAME%_LK4_LABEL %RBNAME%_Y-mark1 "%RBPATH%\Y-mark.hsf"
AXIS6 %RBNAME%_Y-mark1=-10,66,-30,0,-90,0
ADD %RBNAME%_LK4_LABEL %RBNAME%_MOTOMAN2 "%RBPATH%\MOTOMAN.mdl"
AXIS6 %RBNAME%_MOTOMAN2=10,-65,-95,0,90,0
ADD %RBNAME%_LK4_LABEL %RBNAME%_Y-mark2 "%RBPATH%\Y-mark.hsf"
AXIS6 %RBNAME%_Y-mark2=-10,-66,7.5,180,90,0

ADD %RBNAME%_link5 %RBNAME%_LK5_DUMMY dummy
AXIS6 %RBNAME%_LK5_DUMMY=0,0,0,90,90,0
HID %RBNAME%_LK5_DUMMY
ADD %RBNAME%_LK5_DUMMY %RBNAME%_LK5 "%RBPATH%\HP6_LK5.hsf"
AXIS6 %RBNAME%_LK5=0,0,0,0,0,0

ADD %RBNAME%_link6 %RBNAME%_LK6_DUMMY dummy
AXIS6 %RBNAME%_LK6_DUMMY=0,0,0,0,0,0
HID %RBNAME%_LK6_DUMMY
ADD %RBNAME%_LK6_DUMMY %RBNAME%_LK6 "%RBPATH%\HP6_LK6.hsf"
AXIS6 %RBNAME%_LK6=0,0,0,0,0,0

}

